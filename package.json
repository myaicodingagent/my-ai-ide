{
  "name": "my-ai-ide",
  "version": "0.1.0",
  "description": "AI-powered code editor",
  "main": "./out/main/index.js",
  "author": "Abdul Basith",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
