    "test:e2e": "node tests/e2e.cjs",
    "test:real": "node tests/real-e2e.cjs && node tests/real-restart.cjs",
    "test:update-config": "node tests/update-config.cjs",
    "test:git": "node tests/git-handlers.cjs",
    "test:fsops": "node tests/fsops-handlers.cjs",
    "test:index": "node tests/index-handlers.cjs",
    "test:debug": "node tests/debug-handlers.cjs",
    "test:ext": "node tests/ext-handlers.cjs",
    "test:shells": "node tests/shellspec.cjs",
    "test:tasks": "node tests/tasks-handlers.cjs",
    "test:merge": "node tests/merge-parse.cjs",
    "test:contrast": "node tests/a11y-contrast.cjs",
    "test:nbmodel": "node tests/notebook-model.cjs",
    "test:notebook": "node tests/notebook-handlers.cjs",
    "test:e2e-account": "node tests/e2e-account.cjs",
    "test:backend": "node tests/backend-handlers.cjs",
    "test:ext-webview": "node tests/ext-webview.cjs",
    "test:ext-tree": "node tests/ext-tree.cjs",
    "test:lsp": "node tests/lsp.cjs",
    "test:menus2": "node tests/menus2.cjs",
    "test:menus": "node tests/menus.cjs",
    "test:ssh-git": "node tests/ssh-git.cjs",
    "test:ssh": "node tests/ssh-handlers.cjs"
